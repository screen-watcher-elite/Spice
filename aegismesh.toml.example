# ==============================================================================
# AegisMesh Enterprise Gateway Configuration Template
# Copy to `aegismesh.local.toml` (gitignored) or configure live via the UI Settings.
# ==============================================================================

[server]
host = "127.0.0.1"
port = 8080
auto_open_browser = true

[firewall]
default_shield_active = true
policy_preset = "RBI_DPDP_FINTECH_V1"
# Set admin_key via AEGIS_ADMIN_KEY env var or UI Settings to lock shield bypass & PII reveal
# admin_key = ""
rate_limit_rpm = 120

[statutory_limits]
# Reserve Bank of India (RBI) Fair Practices Code & Risk Guardrails
max_auto_refund_amount = 5000.0
max_24h_refund_total = 5000.0
prohibit_frozen_accounts = true
enforce_kyc_transition_rules = true
max_credit_limit_multiplier = 1.25
allowed_tools = [
  "get_customer_profile",
  "get_transaction_history",
  "get_disputes",
  "execute_refund",
  "update_kyc_status",
  "update_credit_limit",
]

[dpdp_act]
# Digital Personal Data Protection (DPDP) Act 2023
vault_ttl_seconds = 300
default_token_format = "AngleUuid" # "AngleUuid" or "BracketIndexed"
strict_aadhaar_verhoeff = false
outbound_pii_mode = "MaskFull"   # "MaskFull" | "Last4" | "RehydrateAuthorized"
mask_pan = true
mask_aadhaar = true
mask_phone = true
mask_email = true
mask_card = true
mask_ifsc = true
mask_upi = true
mask_secrets = true

[google_ai]
# Provide GEMINI_API_KEY via environment or UI Settings (never commit secrets!)
agent_model = "gemini-3.1-flash-lite"
decisions_endpoint = "https://generativelanguage.googleapis.com/v1beta/decisions"
decision_model = "gemini-decision-1"
decisions_mode = "Smart" # "Smart" | "Strict" | "Off"
decision_timeout_secs = 6
cache_ttl_secs = 300

[sentinel]
enabled = true
model = "gemini-3.1-flash-lite"
auto_quarantine_threshold = 0.82
auto_revert_rogue_payouts = true
